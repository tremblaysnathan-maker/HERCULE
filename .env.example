# ==============================================================================
# HERCUL AI - CONFIGURATION DES VARIABLES D'ENVIRONNEMENT (EXEMPLE)
# Copiez ce fichier en tant que '.env' et remplissez avec vos propres clés.
# ==============================================================================

# 🧠 Clé API Google Gemini (Obligatoire - Obtenable sur https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 🔑 Clé secrète d'accès Hercul (Obligatoire - Utilisée pour sécuriser l'API et Tasker)
HERCUL_SECRET_KEY=change_this_to_a_secure_random_key

# 🤖 Token du Bot Discord (Optionnel mais recommandé pour discuter en MP)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 🌐 Google Workspace (Optionnel - pour Gmail, Google Calendar, Tasks & Sheets)
# Déposez également votre fichier google_credentials.json dans le dossier ./data/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

# 🌍 Paramètres Serveur & Fuseau Horaire
HOST=0.0.0.0
PORT=8000
TIMEZONE=Europe/Paris
DEFAULT_ALERT_EMAIL=your_email@example.com

# ⚡ Modèles Google Gemini
GEMINI_FLASH_MODEL=gemini-3.7-flash
GEMINI_FLASH_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_PRO_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 🧠 Optimisation & Gestion des Tokens
MAX_WORKING_MEMORY_TOKENS=8000
MAX_LONG_TERM_RECALL_RESULTS=5

# 📁 Dossiers de persistance
DATA_DIR=./data
WORKSPACE_DIR=./workspace

# 📞 Téléphonie (Optionnel - Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
USER_PHONE_NUMBER=

# 🏠 Domotique (Optionnel - Home Assistant)
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
